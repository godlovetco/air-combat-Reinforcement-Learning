include LICENSE
include README.md
include CHANGELOG.md
include requirements.txt
include install.bat
include dcs_bridge/py.typed

# Ship the DCS Lua addon and the trained checkpoint in the source archive so
# `ucav-install` and the pilot work straight from an extracted release.
recursive-include dcs-addon *.lua
recursive-include checkpoints *.npz
recursive-include docs *.md

global-exclude __pycache__/*
global-exclude *.py[cod]
